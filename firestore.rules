rules_version = '2';

// Regras do Cloud Firestore com suporte a multi-tenancy por escola.
// Publique com: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.email.matches('.*@ure\\.gov\\.br');
    }

    function escolaDoUsuario() {
      let email = request.auth.token.email;
      return email == 'joao@escola.com' ? 'EE Prof. Joao' :
             email == 'maria@escola.com' ? 'EE Maria da Silva' :
             email == 'pedro@escola.com' ? 'EE Dom Pedro II' : '';
    }

    function podeLerMaquina(resourceData) {
      return isAdmin() || resourceData.escola == escolaDoUsuario();
    }

    // Campos que o aplicativo pode alterar.
    function camposDeGestao() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'status',
          'escola',
          'sala',
          'motivo_baixa',
          'data_baixa',
          'usuario_baixa'
        ]);
    }

    match /maquinas/{serial} {
      allow read: if autenticado() && podeLerMaquina(resource.data);

      // Reclassificar, remanejar e dar baixa: permitido para admin ou para a propria escola.
      allow update: if autenticado() && camposDeGestao() && podeLerMaquina(resource.data);

      // Exclusao definitiva apenas por admin da URE.
      allow delete: if autenticado() && isAdmin();

      // Criacao exclusiva do script da bancada (Admin SDK).
      allow create: if false;

      match /leituras/{leitura} {
        allow read: if autenticado() && podeLerMaquina(get(/databases/$(database)/documents/maquinas/$(serial)).data);

        // Exclusao de leituras apenas por admin.
        allow delete: if autenticado() && isAdmin();

        allow create, update: if false;
      }
    }

    match /eventos/{evento} {
      allow read: if autenticado();
      allow create: if autenticado();
      allow update, delete: if false;
    }

    match /bancadas/{id} {
      allow read: if autenticado();
      allow write: if false;
    }
  }
}
